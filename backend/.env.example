# DhuanRadar Backend Configuration
PROJECT_NAME="DhuanRadar - Smoke Awareness System"
API_V1_STR="/api/v1"
DEBUG=true

# NASA FIRMS Hotspots Configuration
# Free map key from: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# If left empty, system automatically uses bundled realistic sample CSV data.
FIRMS_MAP_KEY=""
FIRMS_SOURCE="VIIRS_SNPP_NRT"

# TinyFish Advisory Search & Fetch Configuration
# TinyFish Search and Fetch APIs are free.
# If empty, backend serves cached official MoHFW/CPCB air quality guidance.
TINYFISH_API_KEY=""
TINYFISH_BASE_URL="https://api.tinyfish.io"

# Rules Engine Calibration Defaults (as per slides 4 & 5)
DEFAULT_SEARCH_RADIUS_KM=50.0
HOTSPOT_FRESHNESS_HOURS=24.0

# CORS settings for Flutter Web & Mobile Emulators
CORS_ORIGINS=["*"]
